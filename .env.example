NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
APP_ORIGIN=http://127.0.0.1:3000

# Separate worker runtime only; never expose this token to the browser.
# Provision a dedicated role=testpilot_runner token after migration security review.
# RUNNER_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
# RUNNER_SUPABASE_PUBLISHABLE_KEY=YOUR_PUBLIC_PUBLISHABLE_KEY
# RUNNER_DATABASE_TOKEN=YOUR_DEDICATED_SHORT_LIVED_RUNNER_ROLE_TOKEN

# SaaS deployment environments use distinct Supabase projects and origins.
# Production and staging origins must use HTTPS; see docs/development/deployment.md.
# Set NODE_ENV=production in the runner runtime (the production image does this).
# Supply runner credentials through the platform secret store, not this file.
