{
  "name": "@testpilot/api-spec",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Deterministic OpenAPI validation, parsing and knowledge normalization.",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint . --max-warnings 0"
  },
  "dependencies": {
    "@apidevtools/openapi-schemas": "2.1.0",
    "@testpilot/domain": "workspace:*",
    "ajv": "8.17.1",
    "ajv-draft-04": "1.0.0",
    "yaml": "2.8.1"
  }
}
